{
  "name": "zarra",
  "version": "0.1.0",
  "description": "Zarra — build bosqichisiz, bog'liqliksiz, 3.5 KB'dan kichik reaktiv JavaScript mikro freymvork",
  "type": "module",
  "main": "src/zarra.js",
  "module": "src/zarra.js",
  "types": "types/zarra.d.ts",
  "exports": {
    ".": {
      "types": "./types/zarra.d.ts",
      "import": "./src/zarra.js"
    }
  },
  "unpkg": "dist/zarra.min.js",
  "jsdelivr": "dist/zarra.min.js",
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/ishga.mjs",
    "build": "npx -y esbuild src/zarra.js --minify --format=esm --outfile=dist/zarra.min.js",
    "hajm": "node tools/hajm.mjs",
    "serve": "node tools/server.mjs"
  },
  "keywords": [
    "reaktiv",
    "signal",
    "mikro-freymvork",
    "uzbek",
    "zarra",
    "no-build",
    "zero-dependency"
  ],
  "author": "UrinboyDev <urinboytursunboev@gmail.com>",
  "license": "MIT",
  "sideEffects": false
}
